{
  "name": "fengcode-desktop",
  "version": "1.2.10",
  "description": "Fengcode 桌面端 —— 托盘、全局快捷键、系统通知、拖拽、多标签",
  "main": "main.js",
  "author": "Fengcode Contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.fengcode.desktop",
    "productName": "Fengcode",
    "copyright": "MIT Licensed",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "tray.png",
      "icon.png",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "to": "backend",
        "from": "../cli/dist/Fengcode"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "artifactName": "Fengcode-安装版-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fengcode",
      "language": "2052"
    }
  }
}
